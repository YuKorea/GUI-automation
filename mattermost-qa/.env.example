# 로컬 Docker로 띄운 Mattermost 전용 테스트 계정입니다. 운영 서버 계정을 넣지 마세요.
MM_BASE_URL=http://localhost:8065
MM_TEAM=qa-team
MM_ADMIN_USERNAME=qa-admin
MM_ADMIN_PASSWORD=change-me-Admin1!
MM_USER_USERNAME=qa-user
MM_USER_PASSWORD=change-me-User1!
# (선택) 미리 설치된 Chromium 경로. 비워 두면 Playwright가 설치한 브라우저를 씁니다.
PW_CHROMIUM_PATH=
