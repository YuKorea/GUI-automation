# 관리자 웹 테스트 설정 — 이 파일을 .env로 복사해 실제 값을 입력한다. (.env는 커밋 금지)
BASE_URL=http://<admin-host>:<port>
ADMIN_ID=<admin-id>
ADMIN_PW=<admin-password>

# 선택: 1이면 브라우저 창을 띄워서 실행
HEADED=0

# 선택: 그룹 관리자/작업자 드롭다운에서 고를 이름 (비우면 목록의 첫 항목)
GROUP_MEMBER_ID=
# 선택: 공통코드 검색 테스트에 쓸, 이미 존재하는 코드의 키워드
EXISTING_CODE_KEYWORD=시스템
